<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_bank_bond_interest_line_tree" model="ir.ui.view">
        <field name="name">view.bank.bond.interest.line.tree</field>
        <field name="model">bank.bond.interest.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="bond_id"/>
            </tree>
        </field>
    </record>


    <record id="view_bank_bond_interest_line_form" model="ir.ui.view">
        <field name="name">view.bank.bond.interest.line.form</field>
        <field name="model">bank.bond.interest.line</field>
        <field name="arch" type="xml">
            <form string="Bank Bond Interest Line">
                <sheet>
                    <group>
                        <field name="bond_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

   
    <record id="view_bank_bond_interest_line_search" model="ir.ui.view">
        <field name="name">view.bank.bond.interest.line.search</field>
        <field name="model">bank.bond.interest.line</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Bond" name="bond_id" domain="[]" context="{'group_by':'bond_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_bank_bond_interest_line" model="ir.actions.act_window">
        <field name="name">Bank Bond Interest Line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bank.bond.interest.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Bank Bond Interest Line.
            </p>
        </field>
    </record>

</odoo>
