<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View bank.bond.renewal View Tree -->
    <record id="view_bank_bond_renewal_tree" model="ir.ui.view">
        <field name="name">view.bank.bond.renewal.tree</field>
        <field name="model">bank.bond.renewal</field>
        <field name="arch" type="xml">
            <tree sample="1" duplicate="0">
                <field name="name"/>
                <field name="bond_id"/>
                <field name="date"/>
                <field name="maturity_date"/>
                <field name="state" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'"
                       decoration-primary="state == 'approved'" decoration-success="state == 'done'"
                       decoration-danger="state == 'rejected'" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- View bank.bond.renewal form -->
    <record id="view_bank_bond_renewal_form" model="ir.ui.view">
        <field name="name">view.bank.bond.renewal.form</field>
        <field name="model">bank.bond.renewal</field>
        <field name="arch" type="xml">
            <form string="Bank Bond Renewal" duplicate="0">
                <header>
                


                    <button name="action_done" string="Mark as Done" class="oe_highlight"
                            type="object"
                            confirm="Are you sure?"
                               invisible="state != 'draft'"
                    />
                    <button name="action_set_to_draft" string="Set to Draft" class="oe_highlight"
                            invisible="state not in ['rejected']"
                            type="object"
                    />
                    <field
                            name="state"
                            string="State"
                            widget="statusbar"
                            statusbar_visible="draft,issued"
                            statusbar_colors="{'draft':'blue','issued':'red'}"
                          
                    />
                    
     
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="bond_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="previous_maturity_date" readonly="True" force_save="1"/>
                            <field name="maturity_date" readonly="state != 'draft'" force_save="1"/>
                            <field name="company_id"/>
       
                        </group>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View bank.bond.renewal search -->
    <record id="view_bank_bond_renewal_search" model="ir.ui.view">
        <field name="name">view.bank.bond.renewal.search</field>
        <field name="model">bank.bond.renewal</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action bank.bond.renewal -->
    <record id="action_bank_bond_renewal" model="ir.actions.act_window">
        <field name="name">Bank Bond Renewal</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bank.bond.renewal</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Bank Bond Renewal.
            </p>
        </field>
    </record>

</odoo>
