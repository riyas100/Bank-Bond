<?xml version="1.0"?>
<odoo>
    <record id="ir_cron_bank_bond_maturity_date_alert" model="ir.cron">
        <field name="name">Bank bond Maturity Date Alert</field>
        <field name="model_id" ref="model_bank_bond" />
        <field name="state">code</field>
        <field name="code">model._cron_bank_bond_maturity_date_alert()</field>
        <field name="interval_number">1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:05')" />
        <field eval="False" name="doall"/>
    </record>

    <record id="ir_cron_bank_bond_interest_post" model="ir.cron">
        <field name="name">Post Bank bond Interest Lines</field>
        <field name="model_id" ref="model_bank_bond_interest_line" />
        <field name="state">code</field>
        <field name="code">model._cron_bank_bond_interest_post()</field>
        <field name="interval_number">1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(months=1)).strftime('%Y-%m-%d 00:00:05')" />
        <field eval="False" name="doall"/>
    </record>
</odoo>